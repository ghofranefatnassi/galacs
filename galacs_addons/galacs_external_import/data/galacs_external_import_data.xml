<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="param_dropcontact_api_key" model="ir.config_parameter">
        <field name="key">galacs.dropcontact_api_key</field>
        <field name="value">SET_IN_PRODUCTION</field>
    </record>
    <record id="param_dedup_window" model="ir.config_parameter">
        <field name="key">galacs.dedup_window_days</field>
        <field name="value">30</field>
    </record>
    <record id="param_waalaxy_daily_limit" model="ir.config_parameter">
        <field name="key">galacs.waalaxy_daily_limit</field>
        <field name="value">100</field>
    </record>

    <!-- Cron : nettoyage logs import anciens (doublons > 90 jours) -->
    <record id="ir_cron_galacs_clean_import_logs" model="ir.cron">
        <field name="name">Galacs – Nettoyage logs import Waalaxy (90 jours)</field>
        <field name="model_id" ref="galacs_external_import.model_galacs_external_import"/>
        <field name="state">code</field>
        <field name="code">
cutoff = fields.Datetime.to_string(fields.Datetime.subtract(fields.Datetime.now(), days=90))
old_logs = env['galacs.external.import'].search([
    ('create_date', '&lt;', cutoff),
    ('dedup_blocked', '=', True),
])
old_logs.unlink()
        </field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
