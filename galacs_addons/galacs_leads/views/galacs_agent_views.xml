<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_galacs_linkedin" model="ir.ui.view">
        <field name="name">res.users.form.galacs.linkedin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Galacs.io" name="galacs">
                    <group string="Informations Agent Immobilier">
                        <field name="galacs_linkedin_url" widget="url"
                               placeholder="https://linkedin.com/in/nom-agent"/>
                        <field name="galacs_zone_ids" widget="many2many_tags"
                               placeholder="Ajouter une zone..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
